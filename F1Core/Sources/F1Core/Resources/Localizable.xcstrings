    "player_prompt_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open one feed with native controls or use Multiview to watch multiple feeds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Feed mit nativen Bedienelementen öffnen oder mehrere Feeds mit Multiview ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir una señal con los controles nativos o usar Multivista para ver varias señales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un flux avec les commandes natives ou utiliser Multivue pour regarder plusieurs flux."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open één feed met de standaardbediening of gebruik Multiview om meerdere feeds te bekijken."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir uma transmissão com os controlos nativos ou usar Multivista para ver várias transmissões."
          }
        }
      }
    },
