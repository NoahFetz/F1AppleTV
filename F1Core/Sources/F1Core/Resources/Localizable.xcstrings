    "setup_load_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading a setup replaces the current stream selection. Unavailable streams are skipped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden ersetzt die aktuelle Kanalauswahl. Nicht verfügbare Kanäle werden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar una configuración sustituye los canales actuales. Los no disponibles se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger une configuration remplace les flux actuels. Les flux indisponibles sont ignorés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden vervangt de huidige streams. Niet-beschikbare streams worden overgeslagen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregar uma configuração substitui os canais atuais. Os indisponíveis são ignorados."
          }
        }
      }
    },
    "setup_missing_streams": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some saved streams are unavailable for this session. Available matches were loaded; if none matched, your current selection was kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige gespeicherte Kanäle fehlen in dieser Session. Verfügbare wurden geladen. Ohne Treffer bleibt die aktuelle Auswahl bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos canales guardados no están disponibles. Se cargaron los disponibles; si no hubo coincidencias, se mantuvo tu selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains flux sont indisponibles. Les flux disponibles ont été chargés ; sans correspondance, la sélection actuelle est conservée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige opgeslagen streams zijn niet beschikbaar. Beschikbare streams zijn geladen; zonder overeenkomsten bleef je selectie behouden."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns canais guardados não estão disponíveis. Os disponíveis foram carregados; sem correspondências, manteve-se a seleção atual."
          }
        }
      }
    },
