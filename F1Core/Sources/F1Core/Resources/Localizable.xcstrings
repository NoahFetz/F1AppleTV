    "device_login_instructions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den QR-Code mit deinem Smartphone, um dich bei F1 anzumelden. Oder öffne die Adresse unten und gib den Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code with your phone to sign in to F1. Or open the address below and enter the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR con tu teléfono para iniciar sesión en F1. También puedes abrir la dirección de abajo e introducir el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code QR avec votre téléphone pour vous connecter à F1. Vous pouvez aussi ouvrir l’adresse ci-dessous et saisir le code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan de QR-code met je telefoon om je aan te melden bij F1. Of open het onderstaande adres en voer de code in."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o código QR com o telemóvel para iniciares sessão na F1. Ou abre o endereço abaixo e introduz o código."
          }
        }
      },
      "extractionState": "manual"
    },
