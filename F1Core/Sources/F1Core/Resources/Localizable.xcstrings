    "layout_capacity_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove streams to choose a smaller layout. Adding beyond its capacity returns to Auto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne Kanäle für ein kleineres Layout. Zusätzliche Kanäle wechseln zurück zu Automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita canales para elegir un diseño más pequeño. Si superas su capacidad, se vuelve al modo automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez des flux pour choisir une disposition plus petite. Dépasser sa capacité rétablit le mode automatique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder streams voor een kleinere indeling. Meer streams dan de capaciteit schakelt terug naar Automatisch."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova canais para escolher uma disposição menor. Exceder a capacidade volta ao modo automático."
