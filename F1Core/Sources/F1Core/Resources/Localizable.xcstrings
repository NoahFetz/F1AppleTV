    "device_login_denied": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde auf deinem Smartphone abgelehnt. Du kannst mit einem neuen Code erneut versuchen, dich anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was declined on your phone. You can get a new code to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha rechazado el inicio de sesión en tu teléfono. Puedes obtener otro código para volver a intentarlo."
